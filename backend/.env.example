# DATABASE_URL=postgresql+psycopg2://postgres:Paras@321@localhost:5432/idp_db

# OCR Engine Configuration
# If tesseract is in system PATH, TESSERACT_CMD can remain empty.
TESSERACT_CMD=
OCR_LANGUAGE=eng
OCR_PSM=6
# Optional Poppler path for multi-page scanned PDF conversion (pdftoppm)
# POPPLER_PATH=C:\Program Files\poppler\Library\bin
OCR_PDF_DPI=300

# # AI / LLM Extraction Configuration
# # Optional - leave empty for rule-based extraction only
# # Supported AI_PROVIDER values: gemini, openai, openai_compatible, openrouter, groq, together, ollama, mock, noop
# # For Google Gemini:
# #   AI_PROVIDER=gemini
# #   AI_API_KEY=AIzaSyYourGeminiApiKeyHere
# #   AI_MODEL=gemini-1.5-flash (or gemini-2.0-flash)
# #   AI_BASE_URL= (defaults automatically to https://generativelanguage.googleapis.com/v1beta/openai)
# AI_PROVIDER=
# AI_MODEL=
# AI_API_KEY=
# AI_BASE_URL=
# AI_TIMEOUT=30
# AI_MAX_INPUT_CHARACTERS=12000

